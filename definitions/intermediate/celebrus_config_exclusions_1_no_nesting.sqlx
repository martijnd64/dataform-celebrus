config {
 name: 'celebrus_config_exclusions_1_no_nesting',
 type: "table",
 description: "Celebrus configuration export.",
 schema: "dataform_intermediate",
 tags: ['celebrus', 'daily']
}

/* 1 NO NESTING - CAN BE ON matchNode, valuecontstraint and value */
WITH prep AS (
  SELECT
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.uuid'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode'), '')) AS nodeUuid, 
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.connective'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.match.exclusionconstraints'), '')) AS nodeConnective,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.valueconstraint.attributePathName'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.valueconstraint'), '')) AS nodeAttributePathName,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.valueconstraint.operator'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.valueconstraint'), '')) AS nodeOperator,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.valueconstraint.value.""'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.valueconstraint.value'), '')) AS nodeValue,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.exprconstraint.expression'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.exclusionconstraints.exprconstraint'), '')) AS nodeExpression,
  FROM
    ${ref('celebrus_config_json')}
), filterResults AS (
SELECT *
FROM prep
WHERE ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeExpression, '$')) IS NULL 
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeValue, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeOperator, '$')) IS NULL 
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeAttributePathName, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeConnective, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeUuid, '$')) IS NULL
AND (nodeExpression IS NOT NULL AND nodeExpression != ''
    OR nodeValue IS NOT NULL AND nodeValue != ''
    OR nodeOperator IS NOT NULL AND nodeOperator != ''
    OR nodeAttributePathName IS NOT NULL AND nodeAttributePathName != ''
    OR nodeConnective IS NOT NULL AND nodeConnective != '')
    --OR nodeUuid IS NOT NULL AND nodeUuid != '')
)
SELECT
  nodeUuid,
  IF(SAFE.PARSE_JSON(nodeConnective) IS NOT NULL, '', nodeConnective) AS nodeConnective,
  IF(SAFE.PARSE_JSON(nodeAttributePathName) IS NOT NULL, '', nodeAttributePathName) AS nodeAttributePathName,
  IF(SAFE.PARSE_JSON(nodeOperator) IS NOT NULL, '', nodeOperator) AS nodeOperator,
  nodeValue,
  IF(SAFE.PARSE_JSON(nodeExpression) IS NOT NULL, '', nodeExpression) AS nodeExpression,
FROM filterResults
