config {
 name: 'celebrus_config_extractors_1_no_nesting',
 type: "table",
 description: "Celebrus configuration export.",
 schema: "dataform_intermediate",
 tags: ['celebrus', 'daily']
}

/* 1 NO NESTING - CAN BE ON matchNode, valuecontstraint and value */
WITH prep AS (
  SELECT
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.uuid'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode'), '')) AS nodeUuid, 
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.outAttributePathName'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor'), '')) AS nodeAttributePathName,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.extractionOperator.operator'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.extractionOperator'), '')) AS nodeOperator,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.extractionOperator.value.""'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.extractionOperator.value'), '')) AS nodeValue,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints.connective'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints'), '')) AS nodeSubconstraints,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints.valueconstraint.attributePathName'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints.valueconstraint'), '')) AS nodeSubAttributePathName,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints.valueconstraint.operator'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints.valueconstraint'), '')) AS nodeSubOperator,
    IFNULL(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints.valueconstraint.value.""'), IFNULL(JSON_QUERY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor.subconstraints.valueconstraint.value'), '')) AS nodeSubValue,
  FROM
    ${ref('celebrus_config_json')}
), filterResults AS (
SELECT *
FROM prep
WHERE ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeValue, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeOperator, '$')) IS NULL 
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeAttributePathName, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeUuid, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeSubconstraints, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeSubAttributePathName, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeSubOperator, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeSubValue, '$')) IS NULL
AND (nodeValue IS NOT NULL AND nodeValue != ''
    OR nodeOperator IS NOT NULL AND nodeOperator != ''
    OR nodeAttributePathName IS NOT NULL AND nodeAttributePathName != ''
    OR nodeSubconstraints IS NOT NULL AND nodeSubconstraints != ''
    OR nodeSubAttributePathName IS NOT NULL AND nodeSubAttributePathName != ''
    OR nodeSubOperator IS NOT NULL AND nodeSubOperator != ''
    OR nodeSubValue IS NOT NULL AND nodeSubValue != '')
)
SELECT
  nodeUuid,
  IF(SAFE.PARSE_JSON(nodeAttributePathName) IS NOT NULL, '', nodeAttributePathName) AS nodeAttributePathName,
  IF(SAFE.PARSE_JSON(nodeOperator) IS NOT NULL, '', nodeOperator) AS nodeOperator,
  nodeValue,
  IF(SAFE.PARSE_JSON(nodeSubconstraints) IS NOT NULL, '', nodeSubconstraints) AS nodeSubconstraints,
  IF(SAFE.PARSE_JSON(nodeSubAttributePathName) IS NOT NULL, '', nodeSubAttributePathName) AS nodeSubAttributePathName,
  IF(SAFE.PARSE_JSON(nodeSubOperator) IS NOT NULL, '', nodeSubOperator) AS nodeSubOperator,
  nodeSubValue
FROM filterResults
