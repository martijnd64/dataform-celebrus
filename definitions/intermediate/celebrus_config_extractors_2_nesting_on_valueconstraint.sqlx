config {
 name: 'celebrus_config_extractors_2_nesting_on_valueconstraint',
 type: "table",
 description: "Celebrus configuration export.",
 schema: "dataform_intermediate",
 tags: ['celebrus', 'daily']
}

/* 2 NESTING ON extractor - CAN BE ON (sub)value */
WITH prep AS (
  SELECT
 (
  SELECT
    ARRAY_AGG(CONCAT(JSON_VALUE(xml_string, '$.processing.graph.nodeDefinitions.matchNode.uuid'), '~|', 
    JSON_VALUE(nodeArr, '$.outAttributePathName'), '~|', 
    IFNULL(JSON_VALUE(nodeArr, '$.extractionOperator.operator'), ''), '~|', 
    IFNULL(JSON_VALUE(nodeArr, '$.extractionOperator.value.""'), JSON_QUERY(nodeArr, '$.extractionOperator.value')), '~|', 
    IFNULL(JSON_VALUE(nodeArr, '$.subconstraints.connective'), ''), '~|', 
    IFNULL(JSON_VALUE(nodeArr, '$.subconstraints.valueconstraint.attributePathName'), ''), '~|', 
    IFNULL(JSON_VALUE(nodeArr, '$.subconstraints.valueconstraint.operator'), '')--, '~|', 
    --IFNULL(JSON_VALUE(nodeArr, '$.subconstraints.valueconstraint.value.""'), JSON_QUERY(nodeArr, '$.subconstraints.valueconstraint.value'))
    ))
  FROM
    UNNEST(JSON_QUERY_ARRAY(xml_string, '$.processing.graph.nodeDefinitions.matchNode.match.extractors.extractor')) AS nodeArr)
  AS nodeAttributePathName,
  FROM
    ${ref('celebrus_config_json')}

), dataPrep AS (
SELECT nodeAttributePathName
FROM prep, UNNEST (nodeAttributePathName) as nodeAttributePathName
), resultPrep AS (
SELECT 
  split(nodeAttributePathName, '~|')[offset(0)] as nodeUuid,
  split(nodeAttributePathName, '~|')[offset(1)] as nodeAttributePathName,
  split(nodeAttributePathName, '~|')[offset(2)] as nodeOperator,
  split(nodeAttributePathName, '~|')[offset(3)] as nodeValue,
  split(nodeAttributePathName, '~|')[offset(4)] as nodeSubconstraints,
  split(nodeAttributePathName, '~|')[offset(5)] as nodeSubAttributePathName,
  split(nodeAttributePathName, '~|')[offset(6)] as nodeSubOperator,
  --split(nodeAttributePathName, '~|')[offset(7)] as nodeSubValue,
  -- Fix to not split the pipes found in the values  
  /*ARRAY_TO_STRING((
    SELECT ARRAY_AGG(x) 
    FROM UNNEST(SPLIT(nodeAttributePathName, '|')) AS x 
    WITH OFFSET 
    WHERE OFFSET >= 3
  ), '|') as nodeValue*/
FROM dataPrep)
SELECT *
FROM resultPrep
WHERE ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeValue, '$')) IS NULL
--AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeSubValue, '$')) IS NULL