config {
 name: 'celebrus_config_extractors_3_nesting_on_matchnode',
 type: "table",
 description: "Celebrus configuration export.",
 schema: "dataform_intermediate",
 tags: ['celebrus', 'daily']
}

/* 3 NESTING ON matchNode - CAN BE ON extractor and (sub)value */
WITH prep AS (
  SELECT
 (
  SELECT
    ARRAY_AGG(CONCAT(
      JSON_VALUE(nodeArr, '$.uuid'), '~|', 
      IFNULL(JSON_VALUE(nodeArr, '$.match.extractors.extractor.outAttributePathName'), IFNULL(JSON_QUERY(nodeArr, '$.match.extractors.extractor'), '')), '~|',
      IFNULL(JSON_VALUE(nodeArr, '$.match.extractors.extractor.extractionOperator.operator'), ''), '~|', 
      IFNULL(JSON_VALUE(nodeArr, '$.match.extractors.extractor.extractionOperator.value.""'), IFNULL(JSON_QUERY(nodeArr, '$.match.extractors.extractor.extractionOperator.value'), '')), '~|', 
      IFNULL(JSON_VALUE(nodeArr, '$.match.extractors.extractor.subconstraints.connective'), ''), '~|',
      IFNULL(JSON_VALUE(nodeArr, '$.match.extractors.extractor.subconstraints.valueconstraint.attributePathName'), ''), '~|',
      IFNULL(JSON_VALUE(nodeArr, '$.match.extractors.extractor.subconstraints.valueconstraint.operator'), ''), '~|',
      IFNULL(JSON_VALUE(nodeArr, '$.match.extractors.extractor.subconstraints.valueconstraint.value.""'), IFNULL(JSON_QUERY(nodeArr, '$.match.extractors.extractor.subconstraints.valueconstraint.value'), ''))
      ))
  FROM
    UNNEST(JSON_QUERY_ARRAY(xml_string, '$.processing.graph.nodeDefinitions.matchNode')) AS nodeArr)
  AS nodeAttributePathName,
  FROM
    ${ref('celebrus_config_json')}

), dataPrep AS (
SELECT nodeAttributePathName
FROM prep, UNNEST (nodeAttributePathName) as nodeAttributePathName
), resultPrep AS (
SELECT 
  split(nodeAttributePathName, '~|')[offset(0)] as nodeUuid,
  split(nodeAttributePathName, '~|')[offset(1)] as nodeAttributePathName,
  split(nodeAttributePathName, '~|')[offset(2)] as nodeOperator,
  split(nodeAttributePathName, '~|')[offset(3)] as nodeValue,
  split(nodeAttributePathName, '~|')[offset(4)] as nodeSubconstraints,
  split(nodeAttributePathName, '~|')[offset(5)] as nodeSubAttributePathName,
  split(nodeAttributePathName, '~|')[offset(6)] as nodeSubOperator,
  split(nodeAttributePathName, '~|')[offset(7)] as nodeSubValue,
FROM dataPrep)
SELECT *
FROM resultPrep
WHERE ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeValue, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeSubValue, '$')) IS NULL
AND ARRAY_LENGTH(JSON_QUERY_ARRAY(nodeAttributePathName, '$')) IS NULL
AND nodeAttributePathName IS NOT NULL AND nodeAttributePathName != ''
